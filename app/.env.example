# 複製為 .env.local；此檔只示範欄位，不要提交真實金鑰。
# copilot：Copilot Studio → 本機（不使用 GPT）；auto：Copilot Studio → Azure AI → 本機。
# 另可填 azure 或 local。
ARBOR_AI_PROVIDER=copilot

# Copilot Studio > Channels > Mobile app 顯示的 Token Endpoint。
# Token 只由伺服器取得，不得改成 VITE_ 前綴。
COPILOT_STUDIO_TOKEN_ENDPOINT=
COPILOT_STUDIO_AGENT_NAME=Arbor3D Copilot

# 以下 Azure AI 設定只在 auto／azure 模式作為既有備援。
# Foundry / Azure OpenAI 推論資源 endpoint，例如：
# https://YOUR-RESOURCE.openai.azure.com
# 使用 Microsoft Entra 時不要填入含 /api/projects/... 的專案 endpoint。
AZURE_AI_ENDPOINT=
# 選填：本機可直接沿用 `az login`；部署時建議 Managed Identity。
# 只有無法使用 Microsoft Entra 身分時才填 API key。
AZURE_AI_API_KEY=
AZURE_AI_MODEL=

# 明確開啟後才會產生可能計費的模型呼叫；未開啟時 App 使用本機證據模式。
ARBOR_ALLOW_BILLABLE_CLOUD=NO
