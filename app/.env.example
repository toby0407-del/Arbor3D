# 複製為 .env.local；此檔只示範欄位，不要提交真實金鑰。
# copilot：Copilot Studio → 本機（不使用 GPT）；auto：Copilot Studio → Azure AI → 本機。
# 另可填 azure 或 local。
ARBOR_AI_PROVIDER=copilot

# 正式登入：Microsoft Entra ID（原 Azure Active Directory）。
# VITE_ 三項是 SPA 公開識別／scope，絕對不能放 client secret。
AZURE_ENTRA_TENANT_ID=
AZURE_ENTRA_CLIENT_ID=
AZURE_ENTRA_API_AUDIENCE=api://YOUR-APPLICATION-CLIENT-ID
VITE_AZURE_ENTRA_TENANT_ID=
VITE_AZURE_ENTRA_CLIENT_ID=
VITE_AZURE_ENTRA_SCOPE=api://YOUR-APPLICATION-CLIENT-ID/access_as_user
# App role；只有下列角色可寫入掃描匯入 API。
ARBOR_IMPORT_ROLES=管理者,承辦人

# Azure Cosmos DB for NoSQL；正式 Azure 主機使用 Managed Identity，本機沿用 az login。
AZURE_COSMOS_ENDPOINT=
AZURE_COSMOS_DATABASE=Arbor3D
AZURE_COSMOS_CONTAINER=FieldMeasures
# 僅供明確需要由 App 建立開發資源時使用；正式環境建議執行 infra/azure/main.bicep。
ARBOR_COSMOS_AUTO_CREATE=NO

# Copilot Studio > Channels > Mobile app 顯示的 Token Endpoint。
# Token 只由伺服器取得，不得改成 VITE_ 前綴。
COPILOT_STUDIO_TOKEN_ENDPOINT=
COPILOT_STUDIO_AGENT_NAME=Arbor3D Copilot

# 以下 Azure AI 設定只在 auto／azure 模式作為既有備援。
# Foundry / Azure OpenAI 推論資源 endpoint，例如：
# https://YOUR-RESOURCE.openai.azure.com
# 使用 Microsoft Entra 時不要填入含 /api/projects/... 的專案 endpoint。
AZURE_AI_ENDPOINT=
# 選填：本機可直接沿用 `az login`；部署時建議 Managed Identity。
# 只有無法使用 Microsoft Entra 身分時才填 API key。
AZURE_AI_API_KEY=
AZURE_AI_MODEL=

# 明確開啟後才會產生可能計費的模型呼叫；未開啟時 App 使用本機證據模式。
ARBOR_ALLOW_BILLABLE_CLOUD=NO
