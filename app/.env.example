# 複製為 .env.local；此檔只示範欄位，不要提交真實金鑰。
# phi4：Foundry Local Phi-4 → 本機規則；auto：Phi-4 → Copilot Studio → Azure AI → 本機規則。
# 另可填 copilot、azure 或 local。步驟見 docs/microsoft/PHI4_LOCAL.md
ARBOR_AI_PROVIDER=phi4

# Windows 執行 `foundry server status` 取得 endpoint；只允許 localhost／127.0.0.1／::1。
FOUNDRY_LOCAL_ENDPOINT=
FOUNDRY_LOCAL_MODEL=phi-4-mini

# 需要長時間／多人使用時，改用 Microsoft Foundry Managed Compute 的 HTTPS endpoint。
# provider 設 phi4-cloud；API key 不得加 VITE_ 前綴，Azure 主機優先用 Managed Identity。
PHI4_CLOUD_ENDPOINT=
PHI4_CLOUD_MODEL=Phi-4-mini-instruct
PHI4_CLOUD_API_KEY=

# 正式登入：Microsoft Entra ID（原 Azure Active Directory）。
# VITE_ 三項是 SPA 公開識別／scope，絕對不能放 client secret。
AZURE_ENTRA_TENANT_ID=
AZURE_ENTRA_CLIENT_ID=
AZURE_ENTRA_API_AUDIENCE=api://YOUR-APPLICATION-CLIENT-ID
VITE_AZURE_ENTRA_TENANT_ID=
VITE_AZURE_ENTRA_CLIENT_ID=
VITE_AZURE_ENTRA_SCOPE=api://YOUR-APPLICATION-CLIENT-ID/access_as_user
# App role；只有下列角色可寫入掃描匯入 API。
ARBOR_IMPORT_ROLES=管理者,承辦人

# 現場手測資料庫：有填 endpoint 時用 Cosmos DB FieldMeasures；否則 .runtime 檔案。
# 盤點 JSON／影像不寫入 Cosmos。正式 Azure 主機用 Managed Identity；本機沿用 az login。
AZURE_COSMOS_ENDPOINT=
AZURE_COSMOS_DATABASE=Arbor3D
AZURE_COSMOS_CONTAINER=FieldMeasures
ARBOR_COSMOS_AUTO_CREATE=NO

# Copilot Studio > Channels > Mobile app 的 Token Endpoint（勿加 VITE_ 前綴）。
COPILOT_STUDIO_TOKEN_ENDPOINT=
COPILOT_STUDIO_AGENT_NAME=Arbor3D Copilot

# 以下 Azure AI 只在 auto／azure 模式備援。
AZURE_AI_ENDPOINT=
AZURE_AI_API_KEY=
AZURE_AI_MODEL=

# 明確開啟後才會產生可能計費的模型呼叫；未開啟時用本機證據模式。
ARBOR_ALLOW_BILLABLE_CLOUD=NO

# 雲端 DBH（Azure App Service／Container Apps）。見 docs/microsoft/CLOUD_DBH.md
ARBOR3D_CLOUD_DBH_URL=
ARBOR3D_CLOUD_DBH_API_KEY=
# 本機 GPU：ARBOR3D_CMD=... 或 ARBOR3D_ROOT=...
