{
  "name": "arbor3d-interface",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && npm run build:server",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "node dist-server/productionServer.js",
    "lint": "oxlint",
    "preview": "vite preview",
    "postprocess": "node scripts/run-postprocess.mjs",
    "test": "tsx --test tests/*.test.ts",
    "analytics:excel": "node scripts/export-analytics-excel.mjs",
    "simulate:media": "node scripts/generate-simulated-media.mjs",
    "simulate:media:expand": "python ../scripts/expand_synthetic_media.py --count 12 && node scripts/generate-simulated-media.mjs",
    "simulate:parks": "node scripts/generate-demo-inventories.mjs",
    "rag:generate": "node ../agents/generate_qa_1000.mjs",
    "rag:copilot-pack": "node ../agents/build_copilot_knowledge.mjs",
    "phi4:sft-data": "node ../agents/build_phi4_sft.mjs"
  },
  "dependencies": {
    "@azure/cosmos": "^4.10.1",
    "@azure/identity": "^4.13.3",
    "@azure/msal-browser": "^5.22.0",
    "busboy": "^1.6.0",
    "exceljs": "^4.4.0",
    "jose": "^6.2.12",
    "leaflet": "^1.9.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/busboy": "^1.5.4",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
