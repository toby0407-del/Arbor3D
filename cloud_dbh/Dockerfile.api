# Slim API-only image for smoke tests / prepare-only (no PyTorch).
# Build from repo root:
#   docker build -f cloud_dbh/Dockerfile.api -t arbor3d-cloud-dbh-api:latest .
FROM python:3.11-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    ARBOR3D_CLOUD_WORK_DIR=/var/arbor3d/jobs \
    ARBOR3D_CLOUD_PREPARE_ONLY=true \
    PIP_NO_CACHE_DIR=1

WORKDIR /opt/arbor3d

RUN apt-get update && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

COPY cloud_dbh/requirements.txt /tmp/cloud_dbh-requirements.txt
RUN pip install -r /tmp/cloud_dbh-requirements.txt

COPY cloud_dbh /opt/arbor3d/cloud_dbh
COPY scripts /opt/arbor3d/scripts
# Minimal app tree so prepare-only publish paths exist if ever enabled
RUN mkdir -p /opt/arbor3d/app/src/data/inventories /opt/arbor3d/app/public/scans

RUN mkdir -p /var/arbor3d/jobs /opt/arbor3d/scripts \
    && useradd --create-home --uid 10001 arbor \
    && chown -R arbor:arbor /opt/arbor3d /var/arbor3d

USER arbor
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD curl -fsS http://127.0.0.1:8080/health || exit 1

ENV PYTHONPATH=/opt/arbor3d
CMD ["uvicorn", "cloud_dbh.app:app", "--host", "0.0.0.0", "--port", "8080"]
