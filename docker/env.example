# Copy to .env.docker. No cloud credentials are needed for local demo mode.
ARBOR3D_STORAGE_ROOT=D:/Arbor3D-work/storage
ARBOR3D_BUILD_TARGET=full
ARBOR3D_IMAGE_TAG=local
ARBOR3D_PORT=8080
ARBOR3D_BIND_ADDRESS=127.0.0.1
ARBOR_AI_PROVIDER=local
# Optional cloud settings (runtime secrets stay outside the image):
# AZURE_ENTRA_TENANT_ID=
# AZURE_ENTRA_CLIENT_ID=
# AZURE_ENTRA_API_AUDIENCE=
# VITE_AZURE_ENTRA_TENANT_ID=
# VITE_AZURE_ENTRA_CLIENT_ID=
# VITE_AZURE_ENTRA_API_SCOPE=
# ARBOR_FIELD_STORE=file
